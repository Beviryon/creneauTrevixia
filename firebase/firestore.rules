rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Collection des réservations PFF
    match /reservations/{slotId} {
      // Tout le monde peut lire (afficher les créneaux pris)
      allow read: if true;

      // Création uniquement si le créneau n'existe pas encore
      allow create: if !exists(/databases/$(database)/documents/reservations/$(slotId))
        && request.resource.data.keys().hasAll(['slot', 'fullName', 'email', 'brand', 'createdAt'])
        && request.resource.data.slot is string
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.brand is string;

      // Pas de modification
      allow update: if false;

      // Suppression (annulation par l'étudiant ou reset admin)
      allow delete: if true;
    }

    // Configuration des créneaux (pilotée depuis l'admin)
    match /meta/slots_config {
      // Lecture publique pour afficher le planning côté candidat
      allow read: if true;

      // Écriture uniquement pour un utilisateur connecté (admin côté app)
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['slots'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0;
    }

    // Tout le reste : interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
